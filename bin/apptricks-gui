#!/usr/bin/env bash
# apptricks-gui - Zenity GUI untuk apptricks (pola <BASE>/.[NamaApp])
set -uo pipefail
# Lokasi prefix: $APPTRICKS_BASE > ~/.config/apptricks/config > default XDG.
if [[ -z "${APPTRICKS_BASE:-}" && -f "$HOME/.config/apptricks/config" ]]; then
  # shellcheck disable=SC1090
  . "$HOME/.config/apptricks/config"
fi
BASE="${APPTRICKS_BASE:-$HOME/.local/share/apptricks/prefixes}"
APPTRICKS_CLI="$HOME/.local/bin/apptricks"

err() { zenity --error --text="$1" 2>/dev/null; }
info() { zenity --info --text="$1" 2>/dev/null; }

# Saran nama prefix dari nama file setup (generik, tanpa hardcode app).
# Mapping khusus milik user (opsional) di ~/.config/apptricks/aliases,
# format per baris: pola=nama   contoh: photoshop=.Photoshop
suggest_name() {
  local f; f="$(basename "${1:?}")"
  local low; low="$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')"
  local alias_file="$HOME/.config/apptricks/aliases" pat name
  if [[ -f "$alias_file" ]]; then
    while IFS='=' read -r pat name; do
      [[ -z "$pat" || "$pat" == \#* || -z "$name" ]] && continue
      if [[ "$low" == *"$pat"* ]]; then printf '%s' "$name"; return; fi
    done < "$alias_file"
  fi
  local stem="${f%.*}"
  # buang kata setup/installer/x86/x64 version generik
  stem="$(printf '%s' "$stem" | sed -E 's/^(setup[_-]*|installer[_-]*)//I; s/[_-]*(setup|installer|win64|win32|x86|x64)$//I')"
  # ambil huruf+angka, gabung; misal setup_photoshop2024 -> Photoshop2024
  local cleaned; cleaned="$(printf '%s' "$stem" | tr -cs 'A-Za-z0-9' ' ')"
  local out="" w
  for w in $cleaned; do
    # kapitalisasi huruf pertama tiap kata
    w="$(printf '%s' "$w" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
    out="${out}${w}"
  done
  [[ -z "$out" ]] && out="App"
  printf '.%s' "$out"
}

list_prefixes() {
  ls -d "$BASE"/.*/ 2>/dev/null | grep -v -E '/\./$|/\.\./$' | xargs -r -n1 basename 2>/dev/null || true
}

pick_prefix_or_new() {
  # $1 = judul. Output: nama prefix (.Nama). Return 1 bila batal.
  local title="$1" rows=() p
  while IFS= read -r p; do [[ -n "$p" ]] && rows+=("$p" "prefix ada"); done < <(list_prefixes)
  rows+=("__NEW__" "Buat prefix baru...")
  local sel
  sel="$(zenity --list --title="$title" --column=Prefix --column=Keterangan "${rows[@]}" --width=420 --height=320 2>/dev/null)" || return 1
  if [[ "$sel" == "__NEW__" ]]; then
    local sug="${2:-.AppBaru}"
    local name
    name="$(zenity --entry --title="Nama prefix baru" --text="Nama prefix (otomatis dot-prefix):" --entry-text="$sug" 2>/dev/null)" || return 1
    [[ "$name" != .* ]] && name=".$name"
    printf '%s' "$name"
  else
    printf '%s' "$sel"
  fi
}

do_install_file() {
  local setup="${1:?}"
  [[ -f "$setup" ]] || { err "File tidak ada:\n$setup"; return 1; }
  local sug; sug="$(suggest_name "$setup")"
  local prefix
  prefix="$(pick_prefix_or_new "Install $(basename "$setup") ke..." "$sug")" || return 0
  # init bila belum ada
  if [[ ! -d "$BASE/$prefix" ]]; then
    (echo "# init $prefix"; "$APPTRICKS_CLI" init "$prefix") 2>&1 | zenity --progress --pulsate --auto-close --title="Init $prefix" --text="Membuat prefix..." 2>/dev/null
  fi
  "$APPTRICKS_CLI" install "$prefix" "$setup"
  local rc=$?
  handle_install_rc "$rc" "$prefix" || return 1
  # Tawarkan launcher dari exe ASLI yang dipilih user, bukan ditebak
  offer_launcher "$prefix" ""
}

# Nilai exit installer: banyak installer Windows (NSIS dkk) rutin keluar
# non-nol padahal sukses di bawah Wine. Jadi non-nol = info, bukan vonis.
# Return 0 = lanjut tawarkan launcher; 1 = batal total (misal prefix hilang).
handle_install_rc() {
  local rc="${1:?}" prefix="${2:?}"
  if [[ ! -d "$BASE/$prefix" ]]; then
    err "Prefix $prefix hilang setelah install (kode $rc). Cek $BASE."
    return 1
  fi
  if [[ "$rc" -eq 0 ]]; then
    info "Selesai install ke $prefix"
  else
    info "Installer selesai (kode keluar: $rc).\nKode non-nol umum terjadi dan bukan berarti gagal — app biasanya tetap terinstall.\nLog: $BASE/$prefix/apptricks-install.log"
  fi
  return 0
}

# Tawarkan + buat launcher. $2 boleh kosong → user menunjuk exe di dalam prefix.
offer_launcher() {
  local prefix="${1:?}" exe="${2:-}"
  local pname="${prefix#.}"
  if [[ -z "$exe" ]]; then
    local start="$BASE/$prefix/drive_c/Program Files"
    [[ -d "$start" ]] || start="$BASE/$prefix/drive_c"
    exe="$(zenity --file-selection --title="Pilih exe utama untuk launcher" --filename="$start/" --file-filter="Windows exe | *.exe" 2>/dev/null)" || return 0
  fi
  local where
  where="$(zenity --list --title="Buatkan launcher?" --text="Launcher untuk $pname:" \
    --column=Pilihan --column=Keterangan \
    "menu" "Di menu aplikasi" \
    "desktop" "Di Desktop" \
    "both" "Keduanya" \
    --width=480 --height=260 2>/dev/null)" || return 0
  make_launcher "$prefix" "$exe" "$where"
  cleanup_wine_dupes "$prefix" "$exe"
}

# Hapus entri otomatis Wine yang menduplikasi launcher apptricks:
# .desktop di applications/wine + ~/Desktop yang menunjuk ke prefix ini
# DAN ke folder app yang sama dengan $2. Checklist, default centang kecuali
# *uninstall*. MetaEditor dkk aman (tidak tercentang bila namanya mengandung
# uninstall; sisanya user yang putuskan per centang).
cleanup_wine_dupes() {
  local prefix="${1:?}" exe="${2:?}"
  local appdir bs_pat
  appdir="$(realpath -m "$exe")"
  appdir="${appdir#"$BASE/$prefix"/drive_c/}"
  appdir="$(dirname "$appdir")"
  bs_pat="${appdir//\//\\\\}"
  local cands=() f
  while IFS= read -r f; do
    grep -q "WINEPREFIX=$BASE/$prefix" "$f" 2>/dev/null || continue
    if grep -qiF "$appdir" "$f" 2>/dev/null || grep -qiF "$bs_pat" "$f" 2>/dev/null; then
      cands+=("$f")
    fi
  done < <(find "$HOME/.local/share/applications/wine" "$HOME/Desktop" -name '*.desktop' 2>/dev/null)
  [[ ${#cands[@]} -eq 0 ]] && return 0
  local rows=() b
  for f in "${cands[@]}"; do
    b="$(basename "$f")"
    if [[ "$b" == *[Uu]ninstall* ]]; then rows+=(FALSE "$b"); else rows+=(TRUE "$b"); fi
  done
  local sel
  sel="$(zenity --list --checklist --title="Bersihkan duplikat Wine?" \
    --text="Entri otomatis Wine untuk folder $appdir sudah digantikan launcher apptricks.\nCentang yang mau dihapus:" \
    --column=Hapus --column=File "${rows[@]}" --width=540 --height=300 --separator=$'\n' 2>/dev/null)" || return 0
  local x gone=0
  while IFS= read -r x; do
    [[ -z "$x" ]] && continue
    for f in "${cands[@]}"; do
      if [[ "$(basename "$f")" == "$x" ]]; then rm -f "$f" && gone=$((gone + 1)); fi
    done
  done <<< "$sel"
  if [[ $gone -gt 0 ]]; then
    (kbuildsycoca6 >/dev/null 2>&1 || kbuildsycoca5 >/dev/null 2>&1 || true)
    info "$gone entri Wine dihapus."
  fi
}

# Cari icon untuk launcher. Urutan: (1) icon hasil ekstrak Wine yang cocok
# dengan nama exe, (2) ekstrak sendiri via icoutils bila ada,
# (3) fallback "wine". Cetak NAMA icon (tanpa path/ekstensi).
find_app_icon() {
  local exe="${1:?}" pname="${2:?}"
  local stem lc f
  stem="$(basename "$exe" .exe)"
  lc="$(printf '%s' "$stem" | tr '[:upper:]' '[:lower:]')"
  # (1) icon ekstrak Wine yang sudah ada
  f="$(find "$HOME/.local/share/icons" -iname "*${lc}*" \( -name '*.png' -o -name '*.xpm' \) 2>/dev/null | head -1)"
  if [[ -n "$f" ]]; then
    basename "$f" | sed 's/\.[^.]*$//'
    return 0
  fi
  # (2) ekstrak dari exe (butuh paket icoutils: wrestool + icotool)
  if command -v wrestool >/dev/null 2>&1 && command -v icotool >/dev/null 2>&1; then
    local tmp outdir best
    tmp="$(mktemp -d 2>/dev/null)" || tmp=""
    if [[ -n "$tmp" && -d "$tmp" ]] \
      && wrestool -x -t14 "$exe" -o "$tmp/icon.ico" >/dev/null 2>&1 \
      && icotool -x -o "$tmp" "$tmp/icon.ico" >/dev/null 2>&1; then
      best="$(find "$tmp" -maxdepth 1 -name '*.png' -printf '%s %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)"
      if [[ -n "${best:-}" && -f "$best" ]]; then
        outdir="$HOME/.local/share/icons/hicolor/256x256/apps"
        mkdir -p "$outdir" 2>/dev/null \
          && cp "$best" "$outdir/apptricks-${pname}.png" 2>/dev/null \
          && printf 'apptricks-%s' "$pname" || printf 'wine'
        rm -rf "$tmp"
        return 0
      fi
    fi
    [[ -n "${tmp:-}" ]] && rm -rf "$tmp"
  fi
  # (3) fallback
  printf 'wine'
}

# Buat file .desktop di lokasi: menu | desktop | both.
make_launcher() {
  local prefix="${1:?}" exe="${2:?}" where="${3:-menu}"
  local pname="${prefix#.}"
  local appname
  appname="$(zenity --entry --title="Nama launcher" --text="Nama launcher:" --entry-text="$pname" 2>/dev/null)" || return 0
  appname="${appname//\//-}"
  local icon; icon="$(find_app_icon "$exe" "$pname")"
  local content desk made=() note=""
  content="$(cat <<EOF
[Desktop Entry]
Type=Application
Name=$appname
Exec=env WINEPREFIX=$BASE/$prefix wine "$exe"
Icon=$icon
Categories=Emulator;
Terminal=false
EOF
)"
  case "$where" in
    menu|both)
      mkdir -p "$HOME/.local/share/applications"
      desk="$HOME/.local/share/applications/apptricks-${pname}.desktop"
      printf '%s\n' "$content" > "$desk"; chmod +x "$desk"; made+=("$desk") ;; # +x: syarat eksekusi KDE
  esac
  case "$where" in
    desktop|both)
      mkdir -p "$HOME/Desktop"
      desk="$HOME/Desktop/${appname}.desktop"
      printf '%s\n' "$content" > "$desk"; chmod +x "$desk"; made+=("$desk")
      note="\n\nCatatan: di Desktop, double-click pertama pilih Trust and Launch." ;;
  esac
  (kbuildsycoca6 >/dev/null 2>&1 || kbuildsycoca5 >/dev/null 2>&1 || true)
  info "Launcher dibuat:\n$(printf '%s\n' "${made[@]}")$note"
}

do_run_one() {
  local f="${1:?}"
  local prefix
  prefix="$(pick_prefix_or_new "Jalankan $(basename "$f") dengan..." ".AppBaru")" || return 0
  # Portable di luar prefix? Tawarkan impor agar mandiri di dalam prefix.
  local real_f imported=""; real_f="$(realpath -m "$f" 2>/dev/null || printf '%s' "$f")"
  if [[ "$real_f" != "$BASE/$prefix"/* ]]; then
    local srcdir size
    srcdir="$(dirname "$real_f")"
    size="$(du -sh "$srcdir" 2>/dev/null | cut -f1)"
    if zenity --question --title="Portable di luar prefix" --width=480 \
      --text="Exe ini di luar prefix:\n$real_f\n(folder sumber: $size)\n\nSalin ke dalam prefix agar mandiri?\nYa = salin ke $prefix/drive_c/Portable/ lalu jalankan dari sana.\nTidak = langsung jalankan di tempat." 2>/dev/null; then
      f="$(import_portable "$real_f" "$prefix")" || return 0
      imported=1
    fi
  fi
  # Hasil impor: tawarkan launcher (exe sudah pasti, tanpa file-selection)
  if [[ -n "$imported" ]]; then
    offer_launcher "$prefix" "$f" || true
  fi
  "$APPTRICKS_CLI" run "$prefix" "$f"
}

# Salin folder portable ke <prefix>/drive_c/Portable/<Nama>/ (dengan progress).
# Cetak path exe baru. Idempoten: bila sudah ada, pakai yang ada.
import_portable() {
  local src="${1:?}" prefix="${2:?}"
  local srcdir app dest newexe
  srcdir="$(dirname "$src")"; app="$(basename "$srcdir")"
  dest="$BASE/$prefix/drive_c/Portable/$app"
  newexe="$dest/$(basename "$src")"
  if [[ -f "$newexe" ]]; then
    printf '%s' "$newexe"; return 0
  fi
  mkdir -p "$dest" || return 1
  if command -v rsync >/dev/null 2>&1; then
    (rsync -a --exclude="$(basename "$dest")" "$srcdir"/ "$dest"/) 2>&1 \
      | zenity --progress --pulsate --auto-close --title="Impor portable" --text="Menyalin ke $prefix..." 2>/dev/null
  else
    (cp -a "$srcdir"/. "$dest"/) 2>&1 \
      | zenity --progress --pulsate --auto-close --title="Impor portable" --text="Menyalin ke $prefix..." 2>/dev/null
  fi
  [[ -f "$newexe" ]] || return 1
  printf '%s' "$newexe"
}

do_run_from_prefix() {
  local prefix
  prefix="$(pick_prefix_or_new "Jalankan app dari..." ".AppBaru")" || return 0
  local start="$BASE/$prefix/drive_c/Program Files"
  [[ -d "$start" ]] || start="$BASE/$prefix/drive_c"
  local exe
  exe="$(zenity --file-selection --title="Pilih exe di $prefix" --filename="$start/" --file-filter="Windows exe | *.exe" 2>/dev/null)" || return 0
  "$APPTRICKS_CLI" run "$prefix" "$exe"
}

main_menu() {
  while true; do
    local c
    c="$(zenity --list --title="apptricks" --text="Base: $BASE" \
      --column=Aksi --column=Keterangan \
      "Install exe" "Pilih setup.exe lalu pilih/buat prefix" \
      "Jalankan app" "Pilih prefix lalu pilih exe di dalamnya" \
      "List prefix" "Lihat semua prefix" \
      "Init prefix baru" "Buat prefix kosong" \
      "Winecfg" "Konfigurasi prefix" \
      "Uninstaller" "Daftar program terinstall" \
      --width=520 --height=360 2>/dev/null)" || break
    case "$c" in
      "Install exe")
        f="$(zenity --file-selection --title="Pilih setup.exe" --file-filter="Windows | *.exe *.msi" 2>/dev/null)" && do_install_file "$f" ;;
      "Jalankan app") do_run_from_prefix ;;
      "List prefix")
        list_prefixes | zenity --text-info --title="Prefix di $BASE" --width=400 --height=300 2>/dev/null ;;
      "Init prefix baru")
        n="$(zenity --entry --title="Init prefix" --text="Nama:" --entry-text=".AppBaru" 2>/dev/null)" && "$APPTRICKS_CLI" init "$n" | zenity --text-info --title="Init" --width=500 --height=200 2>/dev/null ;;
      "Winecfg")
        p="$(pick_prefix_or_new "Winecfg untuk..." ".AppBaru")" && "$APPTRICKS_CLI" cfg "$p" ;;
      "Uninstaller")
        p="$(pick_prefix_or_new "Uninstaller untuk..." ".AppBaru")" && "$APPTRICKS_CLI" uninstaller "$p" ;;
    esac
  done
}

case "${1:-}" in
  --install) do_install_file "${2:?}" ;;
  --run-one) do_run_one "${2:?}" ;;
  --suggest) suggest_name "${2:?}"; echo ;;
  *) main_menu ;;
esac
